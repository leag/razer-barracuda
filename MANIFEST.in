include LICENSE README.md CONTRIBUTING.md AGENTS.md uv.lock
recursive-include docs *.md
recursive-include packaging *.desktop *.rules
recursive-include scripts *.py
recursive-include tests *.py
recursive-include barracuda_status/assets *.svg
prune private
prune .vm
prune .assets-official
prune log
global-exclude __pycache__ *.py[cod] *.exe *.dll *.ico

recursive-include kernel/hid-razer-barracuda *.c *.h Makefile dkms.conf
recursive-include kernel/snd-usb-audio *.patch Makefile
recursive-include upstream *.patch .kunitconfig
recursive-include packaging *.conf
global-exclude *.mod.c

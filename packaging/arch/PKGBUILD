# Maintainer: Luis Atala <luis.atala@gmail.com>
# Build from the matching GitHub tag; build.sh also creates the Python sdist
# attached to GitHub releases.
pkgbase=barracuda-pair
pkgname=(barracuda-pair hid-razer-barracuda-dkms plasma6-applets-barracuda)
pkgver=0.6.0
pkgrel=1
pkgdesc="Pairing utility and HID driver for the Razer Barracuda X (2022) HyperSpeed 2.4 GHz wireless dongle"
arch=(any)
url=https://github.com/leag/razer-barracuda
license=(MIT GPL-2.0-only)
# Split packages: namcap wants the runtime dependencies here as well.
makedepends=(python-build python-installer python-setuptools python-wheel
             dkms)
source=("razer-barracuda-$pkgver.tar.gz::https://github.com/leag/razer-barracuda/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ee413ed7c97b6ecb9f398bd40bc0c42fbbb9cdba514da9ee328925a8536e7b2a')

build() {
  cd "razer-barracuda-$pkgver"
  python -m build --wheel --no-isolation
}

package_barracuda-pair() {
  pkgdesc="Command-line pairing utility for the Razer Barracuda X (2022)"
  depends=(python)
  optdepends=('hid-razer-barracuda-dkms: native battery reporting and jack detection'
              'pipewire: optional barracuda-audio Linux tuning'
              'wireplumber: optional barracuda-audio suspend and headroom policy'
              'libpulse: optional microphone controls')
  install=barracuda-pair.install
  cd "razer-barracuda-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/99-razer-barracuda.rules -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSES/TarikTopalovic-MIT.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_plasma6-applets-barracuda() {
  pkgdesc="Plasma 6 widget showing the Barracuda X headset connection status"
  depends=('plasma-workspace>=6.7' plasma-pa plasma5support breeze-icons)
  optdepends=('barracuda-pair: connection status, pairing and headset controls from the widget')
  install=plasma6-applets-barracuda.install
  cd "razer-barracuda-$pkgver"
  local target="$pkgdir/usr/share/plasma/plasmoids/org.razer.barracuda.output"
  install -Dm644 plasmoid/metadata.json -t "$target"
  install -Dm644 plasmoid/contents/ui/*.qml -t "$target/contents/ui"
  install -Dm644 plasmoid/contents/code/output.js -t "$target/contents/code"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_hid-razer-barracuda-dkms() {
  pkgdesc="DKMS HID driver for the Razer Barracuda X (2022) dongle, with the snd-usb-audio jack quirk tool"
  depends=(dkms python git pipewire-alsa)
  optdepends=('linux-headers: build the modules for the linux kernel')
  install=hid-razer-barracuda-dkms.install
  cd "razer-barracuda-$pkgver"
  local src="$pkgdir/usr/src/hid-razer-barracuda-$pkgver"
  install -Dm644 kernel/hid-razer-barracuda/{hid-razer-barracuda.c,hid-ids.h,Makefile,dkms.conf} -t "$src"
  install -Dm644 packaging/99-barracuda-battery.rules packaging/99-barracuda-power.rules packaging/89-razer-barracuda-acp.rules \
    -t "$pkgdir/usr/lib/udev/rules.d"
  install -Dm644 packaging/razer-barracuda.conf \
    -t "$pkgdir/usr/share/alsa-card-profile/mixer/profile-sets"
  install -Dm644 packaging/analog-input-headset-mic-razer-barracuda.conf \
    -t "$pkgdir/usr/share/alsa-card-profile/mixer/paths"
  install -Dm644 packaging/51-barracuda-headphones.conf \
    -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"
  # Build the jack quirk on the target machine for each exact kernel release.
  install -Dm644 packaging/arch/71-barracuda-quirk.hook -t "$pkgdir/usr/share/libalpm/hooks"
  # A build that failed during the upgrade, e.g. offline, is retried at boot.
  local units="$pkgdir/usr/lib/systemd/system"
  install -Dm644 packaging/arch/barracuda-quirk-retry.service -t "$units"
  install -dm755 "$units/multi-user.target.wants"
  ln -s ../barracuda-quirk-retry.service "$units/multi-user.target.wants/barracuda-quirk-retry.service"
  local share="$pkgdir/usr/share/hid-razer-barracuda"
  install -Dm644 kernel/snd-usb-audio/*.patch kernel/snd-usb-audio/Makefile -t "$share/kernel/snd-usb-audio"
  install -Dm755 scripts/install_snd_usb_audio_quirk.py -t "$share/scripts"
  install -dm755 "$pkgdir/usr/bin"
  printf '%s\n' '#!/bin/sh' \
    'exec python3 /usr/share/hid-razer-barracuda/scripts/install_snd_usb_audio_quirk.py --no-profile-set "$@"' \
    > "$pkgdir/usr/bin/barracuda-snd-usb-audio-quirk"
  chmod 755 "$pkgdir/usr/bin/barracuda-snd-usb-audio-quirk"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}

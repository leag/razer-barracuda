pkgbase = barracuda-pair
	pkgdesc = Pairing utility and HID driver for the Razer Barracuda X (2022) HyperSpeed 2.4 GHz wireless dongle
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/leag/razer-barracuda
	arch = any
	license = MIT
	license = GPL-2.0-only
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	makedepends = dkms
	source = razer-barracuda-0.5.0.tar.gz::https://github.com/leag/razer-barracuda/archive/refs/tags/v0.5.0.tar.gz
	sha256sums = 16fa34e09c26df4e83e8f86769a8b25a869ec5743dc9ab61853df9e9f08fe55c

pkgname = barracuda-pair
	pkgdesc = Command-line pairing utility for the Razer Barracuda X (2022)
	depends = python
	optdepends = hid-razer-barracuda-dkms: native battery reporting and jack detection
	optdepends = pipewire: optional software equalizers and monitoring
	optdepends = wireplumber: optional smart filter routing
	optdepends = libpulse: optional microphone controls

pkgname = hid-razer-barracuda-dkms
	pkgdesc = DKMS HID driver for the Razer Barracuda X (2022) dongle, with the snd-usb-audio jack quirk tool
	install = hid-razer-barracuda-dkms.install
	depends = dkms
	depends = python
	depends = git
	depends = pipewire-alsa
	optdepends = linux-headers: build the modules for the linux kernel

pkgname = plasma6-applets-barracuda
	pkgdesc = Plasma 6 widget showing the current audio output device
	depends = plasma-workspace
	depends = plasma-pa
	depends = plasma5support
	depends = breeze-icons
	optdepends = barracuda-pair: pairing and optional audio effects from the widget

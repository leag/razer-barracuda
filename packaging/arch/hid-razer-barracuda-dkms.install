# Other versions install the same module path, so DKMS refuses to install the
# packaged one for new kernels. Unregister them and delete their sources unless
# a package owns them: the dkms hook re-adds every /usr/src tree on each kernel
# install, so unregistering alone lasts only until the next kernel upgrade.
remove_other_versions() {
  src="${DKMS_SOURCE_TREE:-/usr/src}"
  { dkms status -m hid-razer-barracuda 2>/dev/null |
      sed -n 's|^hid-razer-barracuda/\([^,:]*\)[,:].*|\1|p'
    for tree in "$src"/hid-razer-barracuda-*/; do
      [ -f "$tree/dkms.conf" ] && basename "$tree" | sed 's|^hid-razer-barracuda-||'
    done; } | sort -u |
    while read -r version; do
      [ "$version" = "$1" ] && continue
      dkms remove -m hid-razer-barracuda -v "$version" --all 2>/dev/null
      tree="$src/hid-razer-barracuda-$version"
      if [ -d "$tree" ] && [ ! -L "$tree" ] && ! pacman -Qqo "$tree" >/dev/null 2>&1; then
        rm -rf "$tree" &&
          echo "==> Removed hid-razer-barracuda $version, which a manual install left in /usr/src."
      fi
    done
}

post_install() {
  remove_other_versions "${1%-*}"
  cat <<'EOF'
==> Reboot to load the Barracuda driver; nothing was reloaded now.
==> After the reboot, reconnect the dongle and select the Barracuda output once.
==> Headset settings and power-off need membership in the audio group.
==> If the jack-quirk step below fails, retry with:
==>   sudo barracuda-snd-usb-audio-quirk --all-kernels
==> Check the installation any time with: barracuda-headset doctor
EOF
}

post_upgrade() {
  remove_other_versions "${1%-*}"
  cat <<'EOF'
==> Reboot to load the updated Barracuda driver; nothing was reloaded now.
==> Check the installation with: barracuda-headset doctor
EOF
}

pre_remove() {
  barracuda-snd-usb-audio-quirk --all-kernels --remove
}

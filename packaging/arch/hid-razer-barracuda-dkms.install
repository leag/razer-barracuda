# Other registered versions install the same module path, so DKMS refuses to
# install the packaged one for new kernels. Unregister them; sources stay.
remove_other_versions() {
  dkms status -m hid-razer-barracuda 2>/dev/null |
    sed -n 's|^hid-razer-barracuda/\([^,:]*\)[,:].*|\1|p' | sort -u |
    while read -r version; do
      [ "$version" = "$1" ] || dkms remove -m hid-razer-barracuda -v "$version" --all
    done
}

post_install() {
  remove_other_versions "${1%-*}"
  cat <<'EOF'
==> Reboot to load the Barracuda driver; nothing was reloaded now.
==> After the reboot, reconnect the dongle and select the Barracuda output once.
==> Headset settings and power-off need membership in the audio group.
==> If the jack-quirk step below fails, retry with:
==>   sudo barracuda-snd-usb-audio-quirk --all-kernels
==> Check the installation any time with: barracuda-headset doctor
EOF
}

post_upgrade() {
  remove_other_versions "${1%-*}"
  cat <<'EOF'
==> Reboot to load the updated Barracuda driver; nothing was reloaded now.
==> Check the installation with: barracuda-headset doctor
EOF
}

pre_remove() {
  barracuda-snd-usb-audio-quirk --all-kernels --remove
}
